{
  "name": "@stateset/sequencer-sdk",
  "version": "0.8.1",
  "description": "Agent SDK and x402 payment CLI for StateSet Sequencer",
  "homepage": "https://github.com/stateset/stateset-sequencer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stateset/stateset-sequencer.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/stateset/stateset-sequencer/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "bin": {
    "stateset-x402": "./bin/stateset-x402.js",
    "stateset-agent-mcp": "./bin/stateset-agent-mcp.js"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./ves": {
      "types": "./src/ves/client.d.ts",
      "import": "./src/ves/client.js"
    },
    "./x402": {
      "types": "./src/x402/client.d.ts",
      "import": "./src/x402/client.js"
    },
    "./agent-tools": {
      "types": "./src/agent/toolkit.d.ts",
      "import": "./src/agent/toolkit.js"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "ai-agents",
    "ves",
    "x402",
    "payments",
    "stateset",
    "sequencer",
    "agent-to-agent",
    "ed25519"
  ],
  "author": "StateSet",
  "license": "MIT",
  "dependencies": {
    "@noble/ed25519": "^2.0.0",
    "@noble/hashes": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
